      "@prisma/engines": "7.8.0",
      "bcrypt": "6.0.0",
      "canvas": "3.2.3",
      "esbuild": ["0.21.5", "0.27.7"],
      "prisma": "7.8.0",
      "spawn-sync": "1.0.15",
      "tesseract.js": "7.0.0",
      "unrs-resolver": "1.12.2"
