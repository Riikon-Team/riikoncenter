{
  "name": "riikoncenter",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=!konnn-extension",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "prettier": "^3.2.5"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "konnn-extension"
    ]
  }
}